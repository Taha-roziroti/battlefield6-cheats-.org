---
import ResponsiveImage from '../ResponsiveImage.astro';
import type { FragPunkScreenshot } from '../../data/fragpunk/media';
import {
  CONTENT_IMAGE_SIZES,
  CONTENT_IMAGE_WIDTHS,
  SPLIT_IMAGE_SIZES,
  HERO_IMAGE_SIZES,
  HERO_IMAGE_WIDTHS,
} from '../../utils/responsiveImage';

interface Props {
  image: FragPunkScreenshot;
  variant?: 'inline' | 'hero';
  loading?: 'lazy' | 'eager';
  fetchPriority?: 'high' | 'low' | 'auto';
  framed?: boolean;
  /** Tighter srcset sizes when the figure sits in a split column. */
  splitColumn?: boolean;
  class?: string;
}

const {
  image,
  variant = 'inline',
  loading = 'lazy',
  fetchPriority,
  framed = true,
  splitColumn = false,
  class: className,
} = Astro.props;

const widths = variant === 'hero' ? HERO_IMAGE_WIDTHS : CONTENT_IMAGE_WIDTHS;
const sizes =
  variant === 'hero'
    ? HERO_IMAGE_SIZES
    : splitColumn
      ? SPLIT_IMAGE_SIZES
      : CONTENT_IMAGE_SIZES;
const resolvedLoading = variant === 'hero' ? 'eager' : loading;
const resolvedPriority = fetchPriority ?? (variant === 'hero' ? 'high' : undefined);
---

{
  framed ? (
    <figure
      class:list={['glass-border-animated not-prose my-8 overflow-hidden', className]}
      data-reveal
    >
      <div class="glass-border-animated__inner overflow-hidden">
        <ResponsiveImage
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          widths={widths}
          sizes={sizes}
          loading={resolvedLoading}
          fetchPriority={resolvedPriority}
          class="h-auto w-full"
        />
        {
          image.caption && (
            <figcaption class="border-t border-border/60 px-4 py-3 text-sm leading-relaxed text-muted-foreground">
              {image.caption}
            </figcaption>
          )
        }
      </div>
    </figure>
  ) : (
    <figure
      class:list={[
        'not-prose my-8 overflow-hidden rounded-[calc(var(--radius)+2px)] border border-border/70 bg-card/40',
        className,
      ]}
      data-reveal
    >
      <ResponsiveImage
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        widths={widths}
        sizes={sizes}
        loading={resolvedLoading}
        fetchPriority={resolvedPriority}
        class="h-auto w-full"
      />
      {
        image.caption && (
          <figcaption class="border-t border-border/60 px-4 py-3 text-sm leading-relaxed text-muted-foreground">
            {image.caption}
          </figcaption>
        )
      }
    </figure>
  )
}
