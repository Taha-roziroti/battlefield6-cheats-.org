---
import Bf6ArticlePage from '../components/bf6/Bf6ArticlePage.astro';
import { getBf6Page } from '../data/bf6-pages';
import { buildBf6JsonLd } from '../utils/bf6-schema';

const page = getBf6Page('home');
const breadcrumbs = [{ name: 'Home', path: '/' }];
const jsonLd = buildBf6JsonLd(page, breadcrumbs);
---

<Bf6ArticlePage page={page} pageKey="home" breadcrumbs={breadcrumbs} jsonLd={jsonLd} />
