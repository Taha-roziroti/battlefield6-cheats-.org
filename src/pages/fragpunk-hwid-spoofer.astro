---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideArticle from '../components/fragpunk/GuideArticle.astro';
import CheckoutCta from '../components/fragpunk/CheckoutCta.astro';
import { resolvePageSeo } from '../config/seo';
import { hwidSpooferCopy, hwidSpooferFaqs } from '../data/fragpunk/copy';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/fragpunk-hwid-spoofer/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'HWID Spoofer', path: '/fragpunk-hwid-spoofer/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({ name: seo.title, description: seo.description, url: '/fragpunk-hwid-spoofer/' }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <GuideArticle
    h1="FragPunk HWID Spoofer"
    lead={hwidSpooferCopy.lead}
    breadcrumbs={breadcrumbs}
    sections={hwidSpooferCopy.sections}
  />

  <section class="glass-section border-t border-border/60 py-10">
    <div class="guide-page-shell">
      <div class="content-block content-block--plain" data-reveal>
        <h2 class="text-fx-heading text-xl font-semibold">HWID Spoofer FAQs</h2>
        <dl class="mt-6 space-y-6">
          {
            hwidSpooferFaqs.map((item) => (
              <div>
                <dt class="font-medium">{item.q}</dt>
                <dd class="mt-2 text-muted-foreground">{item.a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <div class="guide-page-shell pb-12">
    <CheckoutCta label="Checkout — HWID Spoofer" product="hwidSpoofer" picker={false} />
  </div>
</BaseLayout>
