---
import Bf6ArticlePage from '../components/bf6/Bf6ArticlePage.astro';
import { getBf6Page } from '../data/bf6-pages';
import { buildBf6JsonLd } from '../utils/bf6-schema';

const page = getBf6Page('requirements');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Requirements', path: '/battlefield-6-cheat-requirements/' },
];
---

<Bf6ArticlePage page={page} pageKey="requirements" breadcrumbs={breadcrumbs} jsonLd={buildBf6JsonLd(page, breadcrumbs)} />
