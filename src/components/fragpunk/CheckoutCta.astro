---
import Icon from '../icons/Icon.astro';
import { checkoutPath, type CheckoutProduct } from '../../config/checkout';
import { Button } from '@/components/starwind/button';

interface Props {
  product?: CheckoutProduct;
  label?: string;
  class?: string;
  /** Avoid nested animated borders inside the site hero panel. */
  frame?: 'glass' | 'plain';
  /** When false, link straight to `product` checkout. Default true opens the product picker. */
  picker?: boolean;
}

const {
  product = 'main',
  label = 'Check availability',
  class: className,
  frame = 'glass',
  picker = true,
} = Astro.props;

const directHref = checkoutPath(product);
---

{
  frame === 'plain' ? (
    <div class:list={['not-prose', className]}>
      {picker ? (
        <Button type="button" variant="primary" data-checkout-chooser>
          {label}
          <Icon name="arrowRight" size={17} />
        </Button>
      ) : (
        <Button as="a" href={directHref} variant="primary" target="_self">
          {label}
          <Icon name="arrowRight" size={17} />
        </Button>
      )}
    </div>
  ) : (
    <div class:list={['glass-border-animated not-prose w-fit max-w-full', className]} data-reveal>
      <div class="glass-border-animated__inner p-4">
        {picker ? (
          <Button type="button" variant="primary" data-checkout-chooser>
            {label}
            <Icon name="arrowRight" size={17} />
          </Button>
        ) : (
          <Button as="a" href={directHref} variant="primary" target="_self">
            {label}
            <Icon name="arrowRight" size={17} />
          </Button>
        )}
      </div>
    </div>
  )
}
