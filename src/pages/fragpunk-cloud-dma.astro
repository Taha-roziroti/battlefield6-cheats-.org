---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideArticle from '../components/fragpunk/GuideArticle.astro';
import CheckoutCta from '../components/fragpunk/CheckoutCta.astro';
import { resolvePageSeo } from '../config/seo';
import { cloudDmaCopy, cloudDmaFaqs } from '../data/fragpunk/copy';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/fragpunk-cloud-dma/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Cloud DMA', path: '/fragpunk-cloud-dma/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({ name: seo.title, description: seo.description, url: '/fragpunk-cloud-dma/' }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <GuideArticle
    h1="FragPunk Cloud DMA Requirements"
    lead={cloudDmaCopy.lead}
    breadcrumbs={breadcrumbs}
    sections={cloudDmaCopy.sections}
  />

  <section class="glass-section border-t border-border/60 py-10">
    <div class="mx-auto max-w-3xl px-5 text-left">
      <div class="content-block content-block--plain" data-reveal>
        <h2 class="text-fx-heading text-xl font-semibold">Cloud DMA FAQs</h2>
        <dl class="mt-6 space-y-6">
          {
            cloudDmaFaqs.map((item) => (
              <div>
                <dt class="font-medium">{item.q}</dt>
                <dd class="mt-2 text-muted-foreground">{item.a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-5 pb-12">
    <CheckoutCta label="Open Cloud DMA checkout" product="cloudDma" />
  </div>
</BaseLayout>
