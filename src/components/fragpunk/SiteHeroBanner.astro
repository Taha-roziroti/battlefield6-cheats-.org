---
import '../../styles/site-hero.css';
import Breadcrumbs from '../Breadcrumbs.astro';
import { SITE_HERO_BACKGROUND } from '../../config/site-hero';
import {
  HERO_IMAGE_SIZES,
  HERO_IMAGE_WIDTHS,
  HERO_LCP_WIDTH,
  responsiveSrcSet,
  webpSrc,
  widthsUpToMaster,
} from '../../utils/responsiveImage';
import type { BreadcrumbItem } from '../../utils/schema';

interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  breadcrumbs?: BreadcrumbItem[];
  contentClass?: string;
  class?: string;
  /** Decorative background art behind hero copy (default on). */
  background?: boolean;
}

const {
  title,
  lead,
  eyebrow,
  breadcrumbs,
  contentClass,
  class: className,
  background = true,
} = Astro.props;

const hasActions = Astro.slots.has('default');
const hero = SITE_HERO_BACKGROUND;
const heroWidths = widthsUpToMaster(hero.width, HERO_IMAGE_WIDTHS);
const heroLcp = webpSrc(hero.src, HERO_LCP_WIDTH);
const heroSrcSet = responsiveSrcSet(hero.src, heroWidths);
---

<section
  class:list={['site-hero', !background && 'site-hero--plain', className]}
  aria-labelledby="site-hero-title"
>
  {
    background && (
      <div
        class="site-hero__media"
        style={`background-image: url('${heroLcp}')`}
        aria-hidden="true"
      >
        <img
          src={heroLcp}
          srcset={heroSrcSet}
          sizes={HERO_IMAGE_SIZES}
          width={hero.width}
          height={hero.height}
          alt=""
          class="site-hero__img"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="site-hero__veil" />
        <div class="site-hero__scrim" />
      </div>
    )
  }
  <div
    class:list={[
      'site-hero__content content-rail py-8 sm:py-10 md:py-12 lg:py-14',
      contentClass,
    ]}
  >
    <div class="site-hero__copy">
      {
        breadcrumbs && breadcrumbs.length > 0 && (
          <div class="site-hero__breadcrumbs">
            <Breadcrumbs items={breadcrumbs} />
          </div>
        )
      }
      {eyebrow && <p class="site-hero__eyebrow text-fx-eyebrow">{eyebrow}</p>}
      <header class:list={['space-y-4 text-left', breadcrumbs?.length ? 'mt-4 md:mt-5' : 'mt-0']}>
        <h1 id="site-hero-title" class="site-hero__title text-fx-brand">{title}</h1>
        {lead && <p class="site-hero__lead">{lead}</p>}
      </header>
      {hasActions && <div class="site-hero__actions"><slot /></div>}
    </div>
  </div>
</section>
