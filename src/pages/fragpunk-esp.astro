---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideArticle from '../components/fragpunk/GuideArticle.astro';
import CheckoutCta from '../components/fragpunk/CheckoutCta.astro';
import { resolvePageSeo } from '../config/seo';
import { espCopy } from '../data/fragpunk/copy';
import { resolveFragpunkOg, resolveFragpunkPageMedia } from '../data/fragpunk/media';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/fragpunk-esp/');
const pageMedia = resolveFragpunkPageMedia('/fragpunk-esp/');
const og = resolveFragpunkOg('/fragpunk-esp/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'ESP features', path: '/fragpunk-esp/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={og.ogImage}
  ogImageAlt={og.ogImageAlt ?? seo.title}
  jsonLd={[webPageSchema({ name: seo.title, description: seo.description, url: '/fragpunk-esp/' }), breadcrumbSchema(breadcrumbs)]}
>
  <GuideArticle
    h1="FragPunk ESP Features for PC"
    lead={espCopy.lead}
    breadcrumbs={breadcrumbs}
    sections={espCopy.sections}
    heroImageId={pageMedia.heroId}
    sectionImages={pageMedia.sectionImages}
  />
  <div class="guide-page-shell pb-12">
    <CheckoutCta label="See if checkout is open" />
  </div>
</BaseLayout>
