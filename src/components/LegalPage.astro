---
import SiteHeroBanner from './fragpunk/SiteHeroBanner.astro';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import { ROUTES } from '../utils/path';

interface Props {
  title: string;
  description: string;
  breadcrumbLabel: string;
  sections: { heading: string; paragraphs: string[] }[];
}

const { title, description, breadcrumbLabel, sections } = Astro.props;
---

<SiteHeroBanner
  title={title}
  lead={description}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: breadcrumbLabel, path: Astro.url.pathname },
  ]}
/>
<article class="glass-section py-8 md:py-12">
  <div class="mx-auto max-w-3xl px-5">
    <div class="glass-border-animated" data-reveal data-scroll-tilt>
      <div class="glass-border-animated__inner p-6 md:p-8">
    <Prose class="prose-glass max-w-none text-left">
      {sections.map((section) => (
        <section class="mt-8 first:mt-0">
          <h2 class="text-fx-heading">{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))}
    </Prose>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap justify-center gap-3 border-t border-border pt-8">
      <Button as="a" href={ROUTES.support} variant="primary" size="sm">
        Contact support
        <Icon name="mail" size={16} />
      </Button>
      <Button as="a" href={ROUTES.home} variant="outline" size="sm">Back to home</Button>
    </div>
  </div>
</article>
