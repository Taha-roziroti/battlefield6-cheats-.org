---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FRAGPUNK_FAQS } from '../data/fragpunk/faq';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';
import SiteHeroBanner from '../components/fragpunk/SiteHeroBanner.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';

const seo = resolvePageSeo('/faq/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: 'FragPunk Cheats FAQ',
      description: seo.description,
      url: '/faq/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <SiteHeroBanner
    eyebrow="Help center"
    title="FragPunk cheats FAQ"
    lead="Short answers on money, Cloud DMA, and what we actually know (versus what we read on the product page)."
    breadcrumbs={breadcrumbs}
  />
  <SiteFaqSection items={FRAGPUNK_FAQS} variant="full" titleTag="h2" titleId="faq-topic-heading" />
</BaseLayout>
