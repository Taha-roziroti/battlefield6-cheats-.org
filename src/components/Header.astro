---
import { t } from '../i18n';
import { Button } from '@/components/starwind/button';
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from '@/components/starwind/sheet';
import Icon from './icons/Icon.astro';
import SlideRevealButton from './SlideRevealButton.astro';

import type { IconName } from './icons/types';

const navIcons: Record<string, IconName> = {
  Overview: 'navFeatures',
  Aimbot: 'target',
  ESP: 'eye',
  Pricing: 'acqPackage',
  Review: 'navBlog',
  'Cloud DMA': 'layers',
  'HWID Spoofer': 'sidebarHwid',
  FAQ: 'navFaq',
  Support: 'navSupport',
};

---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div class="site-nav-float flex justify-end px-2 pt-2.5 sm:px-3 sm:pt-3 lg:justify-center" data-floating-nav>
    <div class="site-nav pointer-events-auto site-nav__shell">
      <div class="site-nav__bar">
        <nav class="site-nav__center hidden lg:flex" aria-label="Primary">
          {t.nav.map((link) => (
            <a
              href={link.href}
              class="nav-link inline-flex shrink-0 items-center font-medium leading-none text-muted-foreground transition-colors hover:text-primary"
              data-nav-link
              {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
            >
              <Icon name={navIcons[link.label] ?? 'navFeatures'} size={15} class="nav-link__icon shrink-0" />
              {link.label}
            </a>
          ))}
        </nav>

        <div class="site-nav__actions">
          <Button
            type="button"
            variant="primary"
            size="sm"
            class="inline-flex shrink-0 lg:hidden"
            aria-label={t.ui.checkoutAria}
            data-checkout-chooser
          >
            {t.ui.browseCheatsMobile}
          </Button>
          <div class="hidden items-center lg:flex">
            <SlideRevealButton
              openCheckoutPicker
              class="inline-flex"
              ariaLabel={t.ui.checkoutAria}
            >
              {t.ui.browseCheats}
            </SlideRevealButton>
          </div>

          <Sheet class="lg:hidden">
            <SheetTrigger
              class="inline-flex size-9 items-center justify-center rounded-full border border-border/60 bg-background/30 text-foreground backdrop-blur-sm transition-colors hover:bg-muted/50 lg:hidden"
              aria-label={t.ui.menuOpen}
            >
              <Icon name="menu" size={20} />
            </SheetTrigger>
            <SheetContent side="right" class="flex w-[min(100vw-2rem,20rem)] flex-col gap-4">
              <SheetHeader>
                <SheetTitle>Menu</SheetTitle>
              </SheetHeader>
              <nav class="flex flex-col gap-1" aria-label="Mobile">
                {t.nav.map((link) => (
                  <a
                    href={link.href}
                    class="nav-link flex items-center gap-2 rounded-full px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-primary"
                    data-nav-link
                    {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
                  >
                    <Icon name={navIcons[link.label] ?? 'navFeatures'} size={15} class="nav-link__icon shrink-0" />
                    {link.label}
                  </a>
                ))}
              </nav>
              <Button
                type="button"
                variant="primary"
                class="w-full justify-center"
                aria-label={t.ui.checkoutAria}
                data-checkout-chooser
              >
                {t.ui.browseCheatsMobile}
              </Button>
            </SheetContent>
          </Sheet>
        </div>
      </div>
    </div>
  </div>
</header>
