---
import {
  CONTENT_IMAGE_SIZES,
  CONTENT_IMAGE_WIDTHS,
  defaultWebpSrc,
  rasterMasterUrl,
  responsiveSrcSet,
} from '../utils/responsiveImage';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
  fetchPriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  widths?: readonly number[];
  class?: string;
  desktopOnly?: boolean;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchPriority,
  sizes = CONTENT_IMAGE_SIZES,
  widths = CONTENT_IMAGE_WIDTHS,
  class: className,
  desktopOnly = false,
} = Astro.props;

const isRaster = /\.(png|jpe?g|webp)$/i.test(src);
const srcSet = responsiveSrcSet(src, widths);
const masterIsJpeg = /\.jpe?g$/i.test(src);
/** JPEG masters stay in dist after prune; PNG masters rely on a single WebP fallback `src`. */
const rasterFallbackSrc = masterIsJpeg ? rasterMasterUrl(src) : defaultWebpSrc(src, widths);
const imgSrc = desktopOnly
  ? 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'
  : rasterFallbackSrc;
const imgSrcSet = desktopOnly || masterIsJpeg ? undefined : srcSet;
const pictureSizes = desktopOnly ? '(min-width: 1024px) 490px, 1px' : sizes;
const pictureMedia = desktopOnly ? '(min-width: 1024px)' : undefined;
---

{
  isRaster ? (
    <picture>
      <source type="image/webp" srcset={srcSet} sizes={pictureSizes} media={pictureMedia} />
      <img
        src={imgSrc}
        srcset={imgSrcSet}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding="async"
        fetchpriority={fetchPriority}
        sizes={pictureSizes}
        class={className}
      />
    </picture>
  ) : (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      fetchpriority={fetchPriority}
      class={className}
    />
  )
}
