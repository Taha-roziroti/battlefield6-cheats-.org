---
import '../styles/support-section.css';
import { t } from '../i18n';
import FlipCard from './fragpunk/FlipCard.astro';
import { ROUTES } from '../utils/path';
import { Button } from '@/components/starwind/button';
import Icon from './icons/Icon.astro';

interface Props {
  titleId?: string;
  showTicketTips?: boolean;
  hideHeader?: boolean;
  class?: string;
}

const {
  titleId = 'support-title',
  showTicketTips = false,
  hideHeader = false,
  class: className,
} = Astro.props;
const c = t.support;
---

<section
  id="support"
  class:list={['support-section glass-section border-y border-border/60 py-16 md:py-24', className]}
  aria-labelledby={titleId}
>
  <div class="support-section__inner mx-auto max-w-6xl px-5">
    {hideHeader && <h2 id={titleId} class="sr-only">{c.title}</h2>}
    {
      !hideHeader && (
        <header class="section-header section-header--wide support-section__header">
          <p class="section-header__eyebrow">{c.eyebrow}</p>
          <h1 id={titleId} class="section-header__title">{c.title}</h1>
          <p class="section-header__subtitle">{c.subtitle}</p>
        </header>
      )
    }

    <ul class="support-section__cards">
      {
        c.channels.map((channel) => (
          <li>
            <FlipCard
              class="h-full min-h-[12rem]"
              title={channel.title}
              front={channel.desc}
              back={`Open ${channel.linkLabel} with your order email and a short description of the loader or checkout issue.`}
              href={channel.href}
              linkLabel={channel.linkLabel}
            />
          </li>
        ))
      }
    </ul>

    {
      showTicketTips && (
        <div class="support-section__tips content-block content-block--plain">
          <h3 class="support-section__tips-title">{c.ticketTitle}</h3>
          <ul class="support-section__tips-list">
            {c.ticketItems.map((item) => (
              <li class="support-section__tips-item">
                <p class="support-section__tips-item-title">{item.title}</p>
                <p class="support-section__tips-item-desc">{item.desc}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <p class="mt-10 text-left text-sm text-muted-foreground">
      <Button as="a" href={ROUTES.home} variant="outline" size="sm">
        Back to guides
        <Icon name="arrowRight" size={16} />
      </Button>
    </p>
  </div>
</section>
