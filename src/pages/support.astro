---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import SiteHeroBanner from '../components/fragpunk/SiteHeroBanner.astro';
import ContactSupportSection from '../components/ContactSupportSection.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/support/');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: t.support.title,
      description: t.support.subtitle,
      url: '/support/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Support', path: '/support/' },
    ]),
  ]}
>
  <SiteHeroBanner
    eyebrow={t.support.eyebrow}
    title={t.support.title}
    lead={t.support.subtitle}
    breadcrumbs={[
      { name: 'Home', path: '/' },
      { name: 'Support', path: '/support/' },
    ]}
    contentClass="max-w-6xl"
  />
  <ContactSupportSection titleId="support-page-title" showTicketTips hideHeader />
</BaseLayout>
