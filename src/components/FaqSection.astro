---
import type { SiteFaqItem, FaqTopic } from '../data/faq';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';
import {
  Accordion,
  AccordionContent,
  AccordionItem,
  AccordionTrigger,
} from '@/components/starwind/accordion';

interface Props {
  items: SiteFaqItem[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  titleId?: string;
  showFilters?: boolean;
  filterTopics?: FaqTopic[];
  centered?: boolean;
  /** FAQ column alignment (product pages use left) */
  contentAlign?: 'left' | 'center';
  id?: string;
  class?: string;
  /** When the page already has a hero H1, render this block’s title as H2. */
  titleTag?: 'h1' | 'h2';
}

const {
  items,
  eyebrow = 'FAQ',
  title = 'Straight answers before checkout.',
  subtitle = 'Compatibility, bans and access—no vague promises.',
  titleId = 'faq-heading',
  showFilters = false,
  filterTopics,
  centered = false,
  contentAlign = 'left',
  id: sectionId,
  class: className,
  titleTag = 'h1',
} = Astro.props;

const topicLabels: Record<FaqTopic, string> = {
  all: 'All',
  plans: 'Plans',
  esp: 'Map hack / ESP',
  scripts: 'Scripts',
  safety: 'Safety',
  products: 'Products',
  blog: 'Blog',
  setup: 'Setup',
};

const filters = filterTopics ?? (['all', 'plans', 'esp', 'scripts', 'safety', 'products'] as FaqTopic[]);
---

<section
  id={sectionId}
  class:list={['py-16 md:py-24', className]}
  aria-labelledby={titleId}
  data-faq-section={showFilters ? '' : undefined}
>
  <div class="mx-auto max-w-6xl px-5">
    <div
      class:list={[
        'glass-border-animated',
        contentAlign === 'center' && 'mx-auto max-w-3xl',
        contentAlign === 'left' && 'w-full max-w-none',
      ]}
      data-reveal
    >
      <div class="glass-border-animated__inner p-6 md:p-10">
    <SectionHeader
      eyebrow={eyebrow}
      title={title}
      desc={subtitle}
      titleId={titleId}
      titleTag={titleTag}
      centered={centered}
    />

    {
      showFilters && (
        <div
          class:list={[
            'mt-8 flex flex-wrap gap-2',
            contentAlign === 'center' ? 'justify-center' : 'justify-start',
          ]}
          data-faq-filters
        >
          {filters.map((topic, i) => (
            <button
              type="button"
              class:list={[
                'faq-filter-chip rounded-full border border-border px-3 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:border-primary hover:text-foreground',
                { 'is-active': i === 0 },
              ]}
              data-faq-filter={topic}
            >
              {topicLabels[topic]}
            </button>
          ))}
        </div>
      )
    }

    <Accordion type="single" collapsible class="mt-8 w-full" data-faq-list>
      {items.map((faq, i) => (
        <div data-faq-topic={faq.topic}>
          <AccordionItem value={`faq-${i}`}>
            <AccordionTrigger class="text-left">
              <span class="flex items-center gap-2">
                <Icon name={faq.icon} size={16} class="shrink-0" />
                <span>{faq.q}</span>
              </span>
            </AccordionTrigger>
            <AccordionContent>
              <div class="prose prose-sm dark:prose-invert max-w-none text-muted-foreground" set:html={faq.aHtml ?? faq.a} />
            </AccordionContent>
          </AccordionItem>
        </div>
      ))}
    </Accordion>
      </div>
    </div>
  </div>
</section>
