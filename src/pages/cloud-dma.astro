---
import Bf6ArticlePage from '../components/bf6/Bf6ArticlePage.astro';
import { getBf6Page } from '../data/bf6-pages';
import { buildBf6JsonLd } from '../utils/bf6-schema';

const page = getBf6Page('cloud-dma');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Cloud DMA', path: '/cloud-dma/' },
];
---

<Bf6ArticlePage page={page} pageKey="cloud-dma" breadcrumbs={breadcrumbs} jsonLd={buildBf6JsonLd(page, breadcrumbs)} />
