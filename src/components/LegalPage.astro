---
import SiteHeroBanner from './fragpunk/SiteHeroBanner.astro';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import { ROUTES } from '../utils/path';

interface Props {
  title: string;
  description: string;
  breadcrumbLabel: string;
  sections: { heading: string; paragraphs: string[] }[];
}

const { title, description, breadcrumbLabel, sections } = Astro.props;
---

<SiteHeroBanner
  title={title}
  lead={description}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: breadcrumbLabel, path: Astro.url.pathname },
  ]}
/>
<article class="glass-section py-8 md:py-12">
  <div class="mx-auto max-w-3xl px-5">
    {
      sections.map((section, index) => (
        <section
          class:list={[
            'content-block content-block--plain',
            index % 3 === 1 && 'content-block--glass mx-0 rounded-xl border border-border/50 bg-card/20 p-6 md:p-7',
          ]}
        >
          <Prose class="prose-glass max-w-none text-left">
            <h2 class="text-fx-heading">{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </Prose>
        </section>
      ))
    }

    <div class="mt-12 flex flex-wrap justify-start gap-3 border-t border-border pt-8">
      <Button as="a" href={ROUTES.support} variant="primary" size="sm">
        Contact support
        <Icon name="mail" size={16} />
      </Button>
      <Button as="a" href={ROUTES.home} variant="outline" size="sm">Back to home</Button>
    </div>
  </div>
</article>
