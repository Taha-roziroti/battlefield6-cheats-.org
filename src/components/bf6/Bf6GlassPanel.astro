---
interface Props {
  class?: string;
  media?: boolean;
  /** Stretch to match sibling column height in split rows. */
  fill?: boolean;
  /** Top-align inner content (link lists). */
  alignStart?: boolean;
}

const { class: className, media = false, fill = false, alignStart = false } = Astro.props;
---

<div class:list={['glass-border-animated', fill && 'bf6-glass-fill']}>
  <div
    class:list={[
      'glass-border-animated__inner',
      media && 'bf6-panel--media',
      'bf6-panel',
      alignStart && 'bf6-panel--start',
      className,
    ]}
  >
    <slot />
  </div>
</div>
