---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideArticle from '../components/fragpunk/GuideArticle.astro';
import CheckoutCta from '../components/fragpunk/CheckoutCta.astro';
import { resolvePageSeo } from '../config/seo';
import { reviewCopy } from '../data/fragpunk/copy';
import { fragpunkOgImage, resolveFragpunkOg, resolveFragpunkPageMedia } from '../data/fragpunk/media';
import { breadcrumbSchema, articleSchema } from '../utils/schema';

const seo = resolvePageSeo('/fragpunk-cheats-review/');
const pageMedia = resolveFragpunkPageMedia('/fragpunk-cheats-review/');
const og = resolveFragpunkOg('/fragpunk-cheats-review/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Review', path: '/fragpunk-cheats-review/' },
];
const published = '2026-10-11';
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogType="article"
  ogImage={og.ogImage}
  ogImageAlt={og.ogImageAlt ?? seo.title}
  articlePublishedTime={published}
  articleModifiedTime={published}
  jsonLd={[
    articleSchema({
      name: 'FragPunk Cheats Review',
      description: seo.description,
      url: '/fragpunk-cheats-review/',
      image: fragpunkOgImage('review'),
      datePublished: published,
      schemaType: 'Article',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <GuideArticle
    h1="FragPunk Cheats Review"
    lead={reviewCopy.lead}
    breadcrumbs={breadcrumbs}
    sections={reviewCopy.sections}
    heroImageId={pageMedia.heroId}
    sectionImages={pageMedia.sectionImages}
  />
  <div class="mx-auto max-w-3xl px-5 pb-12">
    <CheckoutCta label="Check the seller page" />
  </div>
</BaseLayout>
