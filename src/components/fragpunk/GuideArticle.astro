---
import SiteHeroBanner from './SiteHeroBanner.astro';
import { Prose } from '@/components/starwind/prose';
import type { BreadcrumbItem } from '../../utils/schema';
import FragPunkFigure from './FragPunkFigure.astro';
import {
  FRAGPUNK_SCREENSHOTS,
  fragpunkScreenshot,
  type FragPunkScreenshotId,
} from '../../data/fragpunk/media';

export interface GuideSection {
  id?: string;
  heading: string;
  paragraphs: string[];
  links?: { href: string; text: string }[];
}

interface Props {
  h1: string;
  lead?: string;
  breadcrumbs: BreadcrumbItem[];
  sections: GuideSection[];
  heroImageId?: FragPunkScreenshotId;
  sectionImages?: Partial<Record<string, FragPunkScreenshotId>>;
}

const { h1, lead, breadcrumbs, sections, heroImageId, sectionImages = {} } = Astro.props;
const heroImage = heroImageId ? fragpunkScreenshot(heroImageId) : undefined;
---

<SiteHeroBanner title={h1} lead={lead} breadcrumbs={breadcrumbs} />
<section class="glass-section py-8 md:py-12">
  <div class="mx-auto max-w-3xl px-5">
    {heroImage && <FragPunkFigure class="mb-10" image={heroImage} />}
    <div class="glass-border-animated" data-reveal data-scroll-tilt>
      <div class="glass-border-animated__inner p-6 md:p-8">
    <Prose class="prose-glass max-w-none text-left">
      {
        sections.map((section) => (
          <section class="mt-8 scroll-mt-24 first:mt-0">
            <h2 id={section.id} class="text-fx-heading">{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {
              section.id &&
                sectionImages[section.id] && (
                  <FragPunkFigure image={FRAGPUNK_SCREENSHOTS[sectionImages[section.id]!]} />
                )
            }
            {
              section.links?.map((link) => (
                <p>
                  <a href={link.href}>{link.text}</a>
                </p>
              ))
            }
          </section>
        ))
      }
    </Prose>
      </div>
    </div>
  </div>
</section>
