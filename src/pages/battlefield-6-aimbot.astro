---
import Bf6ArticlePage from '../components/bf6/Bf6ArticlePage.astro';
import { getBf6Page } from '../data/bf6-pages';
import { buildBf6JsonLd } from '../utils/bf6-schema';

const page = getBf6Page('aimbot');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Aimbot', path: '/battlefield-6-aimbot/' },
];
---

<Bf6ArticlePage page={page} pageKey="aimbot" breadcrumbs={breadcrumbs} jsonLd={buildBf6JsonLd(page, breadcrumbs)} />
