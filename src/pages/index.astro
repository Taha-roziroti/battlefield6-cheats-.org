---
import BaseLayout from '../layouts/BaseLayout.astro';
import CheckoutCta from '../components/fragpunk/CheckoutCta.astro';
import GuideSectionBlock from '../components/fragpunk/GuideSectionBlock.astro';
import HomeQuickFlips from '../components/fragpunk/HomeQuickFlips.astro';
import FragPunkMediaCarousel from '../components/fragpunk/FragPunkMediaCarousel.astro';
import SiteHeroBanner from '../components/fragpunk/SiteHeroBanner.astro';
import SiteHeroPreload from '../components/fragpunk/SiteHeroPreload.astro';
import { resolvePageSeo } from '../config/seo';
import { homeCopy } from '../data/fragpunk/copy';
import { FRAGPUNK_MAIN_PLANS } from '../data/fragpunk/pricing';
import {
  fragpunkScreenshot,
  resolveFragpunkOg,
  resolveFragpunkPageMedia,
} from '../data/fragpunk/media';
import {
  organizationSchema,
  productSchema,
  webPageSchema,
  websiteSchema,
} from '../utils/schema';
import { checkoutPath } from '../config/checkout';

const seo = resolvePageSeo('/');
const monthly = FRAGPUNK_MAIN_PLANS[0]!;
const pageMedia = resolveFragpunkPageMedia('/');
const og = resolveFragpunkOg('/');

const sectionVariant = (id?: string) => {
  switch (id) {
    case 'features-glance':
      return 'plain' as const;
    case 'player-esp':
      return 'split' as const;
    case 'aimbot':
      return 'glass' as const;
    case 'plans':
      return 'flip' as const;
    default:
      return 'plain' as const;
  }
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={og.ogImage}
  ogImageAlt={og.ogImageAlt ?? seo.title}
  jsonLd={[
    websiteSchema(),
    organizationSchema(),
    webPageSchema({
      name: 'FragPunk Cheats for PC',
      description: seo.description,
      url: '/',
    }),
    productSchema({
      name: 'FragPunk Cheats for PC',
      description:
        'FragPunk cheat access with aimbot and ESP modules; confirm current pricing on checkout.',
      url: '/',
      offerUrl: checkoutPath('fragpunk'),
      priceUsd: monthly.priceUsd,
    }),
  ]}
>
  <SiteHeroPreload />
  <SiteHeroBanner title="FragPunk Cheats for PC" lead={homeCopy.lead} priority>
    <CheckoutCta frame="plain" label="See if checkout is open" />
  </SiteHeroBanner>

  <section class="glass-section py-10 md:py-12">
    <div class="guide-page-shell">
      {
        homeCopy.sections.map((section) => {
          const imageId = section.id ? pageMedia.sectionImages[section.id] : undefined;
          const image = imageId ? fragpunkScreenshot(imageId) : undefined;
          const variant = sectionVariant(section.id);
          return (
            <div class="home-section-wrap">
              <GuideSectionBlock section={section} variant={variant} image={image} />
              {section.id === 'features-glance' && <HomeQuickFlips />}
            </div>
          );
        })
      }
    </div>
  </section>

  <FragPunkMediaCarousel />
</BaseLayout>
