---
import FragPunkFigure from './FragPunkFigure.astro';
import {
  FRAGPUNK_SCREENSHOTS,
  HOME_GALLERY_IDS,
  type FragPunkScreenshotId,
} from '../../data/fragpunk/media';

interface Props {
  ids?: FragPunkScreenshotId[];
  heading?: string;
  intro?: string;
}

const {
  ids = HOME_GALLERY_IDS,
  heading = 'In-game overlay examples',
  intro = 'These captures show how ESP boxes, skeletons, and aim FOV rings can look in FragPunk. Your loader may differ—compare with the latest build in your portal.',
} = Astro.props;
---

<section class="glass-section border-t border-border/60 py-10 md:py-14" aria-labelledby="fragpunk-gallery-heading">
  <div class="mx-auto max-w-5xl px-5">
    <header class="glass-panel max-w-3xl p-6 text-left md:p-8" data-reveal>
      <h2 id="fragpunk-gallery-heading" class="text-fx-heading text-2xl font-semibold normal-case md:text-3xl">
        {heading}
      </h2>
      <p class="mt-3 text-muted-foreground leading-relaxed">{intro}</p>
    </header>
    <ul class="mt-8 grid list-none gap-6 p-0 sm:grid-cols-2">
      {
        ids.map((id) => {
          const image = FRAGPUNK_SCREENSHOTS[id];
          return (
            <li class="transition-transform duration-200 hover:scale-[1.01] focus-within:scale-[1.01]">
              <FragPunkFigure image={image} variant="inline" />
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
