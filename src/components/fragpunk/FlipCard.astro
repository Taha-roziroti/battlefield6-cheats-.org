---
import { affiliateRelAttrs } from '../../config/affiliate';

interface Props {
  title: string;
  front: string;
  back: string;
  href?: string;
  linkLabel?: string;
  hideTitle?: boolean;
  class?: string;
  openCheckoutPicker?: boolean;
}

const {
  title,
  front,
  back,
  href,
  linkLabel = 'Learn more',
  hideTitle = false,
  class: className,
  openCheckoutPicker = false,
} = Astro.props;
---

<article class:list={['flip-card', className]} tabindex="0">
  <div class="flip-card__inner">
    <div class="flip-card__face flip-card__face--front">
      {!hideTitle && <h3 class="flip-card__title">{title}</h3>}
      <p class="flip-card__body">{front}</p>
    </div>
    <div class="flip-card__face flip-card__face--back">
      <p class="flip-card__body">{back}</p>
      {openCheckoutPicker ? (
        <button type="button" class="flip-card__link" data-checkout-chooser>
          {linkLabel}
        </button>
      ) : (
        href && (
          <a class="flip-card__link" href={href} {...affiliateRelAttrs(href)}>
            {linkLabel}
          </a>
        )
      )}
    </div>
  </div>
</article>
