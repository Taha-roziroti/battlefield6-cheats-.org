{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-brand-icons.mjs && node scripts/prebuild-images.mjs && node scripts/verify-deploy-images.mjs && astro build && node scripts/write-checkout-redirects.mjs && node scripts/prune-dist-images.mjs && node scripts/finalize-sitemap.mjs && node scripts/indexnow.mjs",
    "generate:icons": "node scripts/generate-brand-icons.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "seo:audit": "node scripts/seo-audit.mjs",
    "start": "node scripts/serve.mjs",
    "astro": "astro",
    "optimize:images": "node scripts/optimize-images.mjs",
    "images:4k": "node scripts/ai-enhance-masters.mjs && node scripts/optimize-images.mjs",
    "images:4k:sharp": "node scripts/upscale-enhance-masters.mjs && node scripts/optimize-images.mjs",
    "images:ai": "node scripts/ai-enhance-masters.mjs && node scripts/optimize-images.mjs",
    "images:restore": "node scripts/restore-masters-from-backup.mjs && node scripts/optimize-images.mjs",
    "ingest:bf6-gameplay": "node scripts/ingest-bf6-gameplay.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.48.0",
    "@starwind-ui/astro": "^1.2.1",
    "@tabler/icons": "^3.48.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.2"
  }
}
