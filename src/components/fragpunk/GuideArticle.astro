---
import SiteHeroBanner from './SiteHeroBanner.astro';
import GuideSectionBlock from './GuideSectionBlock.astro';
import type { BreadcrumbItem } from '../../utils/schema';
import FragPunkFigure from './FragPunkFigure.astro';
import {
  FRAGPUNK_SCREENSHOTS,
  fragpunkScreenshot,
  type FragPunkScreenshotId,
} from '../../data/fragpunk/media';

export interface GuideSection {
  id?: string;
  heading: string;
  paragraphs: string[];
  links?: { href: string; text: string }[];
}

export type GuideSectionVariant = 'plain' | 'glass' | 'flip' | 'split';

interface Props {
  h1: string;
  lead?: string;
  breadcrumbs: BreadcrumbItem[];
  sections: GuideSection[];
  heroImageId?: FragPunkScreenshotId;
  sectionImages?: Partial<Record<string, FragPunkScreenshotId>>;
}

const { h1, lead, breadcrumbs, sections, heroImageId, sectionImages = {} } = Astro.props;
const heroImage = heroImageId ? fragpunkScreenshot(heroImageId) : undefined;

const VARIANT_CYCLE: GuideSectionVariant[] = ['plain', 'split', 'glass', 'flip'];

function resolveVariant(index: number, hasImage: boolean): GuideSectionVariant {
  const base = VARIANT_CYCLE[index % VARIANT_CYCLE.length]!;
  if (hasImage && base === 'plain') return 'split';
  return base;
}
---

<SiteHeroBanner title={h1} lead={lead} breadcrumbs={breadcrumbs} />
<section class="glass-section py-6 md:py-10">
  <div class="guide-page-shell">
    {heroImage && <FragPunkFigure class="mb-10" image={heroImage} />}
    {
      sections.map((section, index) => {
        const imageId = section.id ? sectionImages[section.id] : undefined;
        const image = imageId ? FRAGPUNK_SCREENSHOTS[imageId] : undefined;
        const variant = resolveVariant(index, Boolean(image));
        return (
          <GuideSectionBlock
            section={section}
            variant={variant}
            image={image}
          />
        );
      })
    }
  </div>
</section>
