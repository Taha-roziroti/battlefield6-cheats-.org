---
import Icon from '../icons/Icon.astro';
import { checkoutPath } from '../../config/checkout';
import { MAIN_PRODUCT_PLANS } from '../../data/fragpunk/pricing';
import { Button } from '@/components/starwind/button';

const monthly = MAIN_PRODUCT_PLANS[0]!;
const lifetime = MAIN_PRODUCT_PLANS[1]!;
const mainCheckout = checkoutPath('main');
const checkoutLink = { target: '_self' as const };
---

<section class="global-purchase-bar border-t border-border/60" aria-label="Buy Battlefield 6 cheats">
  <div class="guide-page-shell py-8 md:py-10">
    <div class="glass-border-animated" data-reveal>
        <div class="glass-border-animated__inner p-5 md:p-7">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
            <div class="max-w-xl text-left">
              <p class="text-xs font-semibold uppercase tracking-wider text-primary">Ready to buy</p>
              <h2 class="text-fx-heading mt-2 text-xl font-semibold md:text-2xl">Battlefield 6 access options</h2>
              <p class="mt-2 text-sm text-muted-foreground md:text-base">
                ${monthly.priceUsd} for {monthly.term} or ${lifetime.priceUsd}{' '}
                {lifetime.term.toLowerCase()} — aimbot and ESP included. Cloud DMA and HWID Spoofer are separate
                if you need them.
              </p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center lg:justify-end">
              <Button type="button" variant="primary" class="justify-center" data-checkout-chooser>
                Choose product
                <Icon name="arrowRight" size={17} />
              </Button>
              <Button as="a" href="/#listed-plans-and-pricing" variant="outline" class="justify-center">
                View plans
              </Button>
            </div>
          </div>
          <ul class="mt-6 flex flex-wrap gap-x-4 gap-y-2 border-t border-border/50 pt-5 text-sm">
            <li>
              <a href={mainCheckout} class="text-primary hover:underline" {...checkoutLink}>Main plan checkout</a>
            </li>
            <li>
              <a href={checkoutPath('cloudDma')} class="text-muted-foreground hover:text-primary" {...checkoutLink}>
                Cloud DMA checkout
              </a>
            </li>
            <li>
              <a href={checkoutPath('hwidSpoofer')} class="text-muted-foreground hover:text-primary" {...checkoutLink}>
                HWID Spoofer checkout
              </a>
            </li>
          </ul>
        </div>
    </div>
  </div>
</section>
