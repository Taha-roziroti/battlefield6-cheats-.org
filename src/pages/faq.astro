---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_FAQS } from '../data/fragpunk/faq';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';
import SiteHeroBanner from '../components/fragpunk/SiteHeroBanner.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';

const seo = resolvePageSeo('/faq/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: 'Battlefield 6 Cheats FAQ',
      description: seo.description,
      url: '/faq/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <SiteHeroBanner
    eyebrow="Help center"
    title="Battlefield 6 cheats FAQ"
    lead="Short answers on pricing, Cloud DMA, requirements, and what the current product listings describe."
    breadcrumbs={breadcrumbs}
  />
  <SiteFaqSection items={SITE_FAQS} variant="full" titleTag="h2" titleId="faq-topic-heading" />
</BaseLayout>
